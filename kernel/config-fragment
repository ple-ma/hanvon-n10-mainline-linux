# Hanvon N10 (RK3566) 需要打开的内核选项 (合并进 defconfig)
# 显示/墨水屏(基线树自带, 列出供参考)
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_EBC=y
# WiFi (brcmfmac43456, 固件需进initramfs)
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# 电磁笔 uart5
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# 音频 (RK817 codec)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SIMPLE_CARD_UTILS=y
# USB (DWC3 双角色 + XHCI, 支持Hub/键盘/U盘/网卡)
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
# 常用USB外设
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_NET_AX_USB_NIC=y   # ASIX官方驱动(树内drivers/ax_usb_nic), 支持AX88179A
